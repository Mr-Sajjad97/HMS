rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sajjadshaha58@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'department', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'role', 'department', 'createdAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.role is string && data.role in ['ADMIN', 'DOCTOR', 'LAB_TECH', 'PHARMACIST', 'CASHIER', 'ACCOUNTANT', 'HR_MANAGER'] &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
             data.createdAt is timestamp;
    }

    // Validation Blueprint: AuditLog
    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'actorRole', 'module', 'action', 'entityId', 'summary', 'createdAt']) &&
             data.keys().hasOnly(['actorUid', 'actorEmail', 'actorRole', 'module', 'action', 'entityId', 'summary', 'createdAt']) &&
             data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.actorUid == request.auth.uid &&
             data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 256 &&
             data.actorRole is string && data.actorRole.size() >= 2 && data.actorRole.size() <= 40 &&
             data.module is string && data.module.size() >= 2 && data.module.size() <= 60 &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
             data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
             data.createdAt is timestamp;
    }

    // Validation Blueprint: ErpSnapshot
    function isValidErpSnapshot(data) {
      return data.keys().hasAll(['ownerId', 'hospitalName', 'version', 'updatedAt', 'createdAt']) &&
             data.keys().hasOnly(['ownerId', 'hospitalName', 'version', 'updatedAt', 'createdAt']) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.ownerId == request.auth.uid &&
             data.hospitalName is string && data.hospitalName.size() >= 1 && data.hospitalName.size() <= 160 &&
             data.version is int && data.version >= 1 &&
             data.updatedAt is timestamp &&
             data.createdAt is timestamp;
    }

    // Collection 1: /users/{userId} (PII Isolated to Owner or Admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    incoming().createdAt == request.time &&
                    (incoming().role != 'ADMIN' || request.auth.token.email == 'sajjadshaha58@gmail.com');
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
                    isAdmin() ||
                    (request.auth.uid == userId &&
                     incoming().uid == existing().uid &&
                     incoming().role == existing().role &&
                     incoming().createdAt == existing().createdAt &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'department']))
                  );
      allow delete: if false;
    }

    // Collection 2: /audit_logs/{logId} (Append-only Immutable Audit Log)
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().actorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.actorUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(logId) &&
                    isValidAuditLog(incoming()) &&
                    incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // Collection 3: /erp_snapshots/{snapshotId}
    match /erp_snapshots/{snapshotId} {
      allow get: if isSignedIn() && isValidId(snapshotId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(snapshotId) &&
                    isValidErpSnapshot(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(snapshotId) && isValidErpSnapshot(incoming()) && (
                    isAdmin() ||
                    (existing().ownerId == request.auth.uid &&
                     incoming().ownerId == existing().ownerId &&
                     incoming().createdAt == existing().createdAt &&
                     incoming().updatedAt == request.time &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['hospitalName', 'version', 'updatedAt']))
                  );
      allow delete: if false;
    }
  }
}
